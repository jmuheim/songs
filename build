#!/usr/bin/env ruby

require 'optparse'
require 'json'
require 'net/http'
require 'nokogiri'
require_relative 'lib/build_helpers'
include BuildHelpers

ENV['LANG'] = 'en_US.UTF-8'
Encoding.default_external = Encoding::UTF_8

Dir.chdir(__dir__)

MULTIPLEX_URL     = 'https://multiplex.up.railway.app'
MASTER_PASSWORD   = ENV.fetch('MASTER_PASSWORD', 'guitar')
MULTIPLEX_TOKEN   = File.exist?('multiplex-token.json') \
  ? JSON.parse(File.read('multiplex-token.json')) \
  : JSON.parse(Net::HTTP.get(URI("#{MULTIPLEX_URL}/token"))).tap { |t| File.write('multiplex-token.json', JSON.generate(t)) }

options = { deploy: false }
OptionParser.new do |opts|
  opts.banner = "Usage: build [options]"
  opts.on("--deploy", "Deploy to songs.josh.ch via rsync") { options[:deploy] = true }
end.parse!

def step(emoji, label)
  print "#{emoji}  #{label}... "
  t = Time.now
  result = yield
  puts "✅ (#{"%.1f" % (Time.now - t)}s)"
  result
end


puts "🎸 Building song book"
puts

song_files = Dir["content/songs/*.md"].sort
puts "🎵 Songs (#{song_files.size}):"
song_files.each { |f| puts "   🎶 #{File.basename(f, ".md")}" }
puts

song_files.each { |file| validate_song!(file, File.read(file, encoding: 'UTF-8')) }

step("📝", "Writing all-songs.md") do
  File.write("all-songs.md", songbook_markdown(song_files, "content/Introduction.md"))
end

step("🌙", "Generating index.html (Pandoc)") do
  print pandoc!("all-songs.md", "index.html", theme: "night", revealjs_url: "./style/revealjs")
end

step("✨", "Post-processing index.html") do
  multiplex = { url: MULTIPLEX_URL, socketId: MULTIPLEX_TOKEN['socketId'], secret: MULTIPLEX_TOKEN['secret'], password: MASTER_PASSWORD }
  File.write("index.html", post_process_index(File.read("index.html"), assets: "style/", multiplex: multiplex))
end

step("🖨️", "Generating print.html (Pandoc)") do
  print pandoc!("all-songs.md", "print.html", theme: "serif", revealjs_url: "./style/revealjs")
end

step("✨", "Post-processing print.html") do
  File.write("print.html", post_process_print(File.read("print.html"), assets: "style/"))
end

if options[:deploy]
  step("🚀", "Deploying to songs.josh.ch") do
    puts
    system("rsync -avz --delete index.html style maroni@greip.uberspace.de:/var/www/virtual/maroni/songs.josh.ch/")
  end
end

puts
puts "🎉 Done!"
