# Deployed verbatim alongside index.html and style/ (see the "Deploy to
# songs.josh.ch" step in .github/workflows/test.yml and build's --deploy).
#
# Without an explicit Cache-Control, browsers fall back to heuristic caching
# of index.html and style/*.css|js, which can hold onto an old build for
# hours — worst on phones, where "Add to Home Screen" bookmarks on iOS Safari
# use a webview that caches even more aggressively than a normal tab. These
# files keep the same name on every deploy, so a cached copy never looks
# stale to the browser on its own.
#
# no-cache (despite the name) still lets the browser keep a local copy — it
# just forces a conditional request against it on every load, so an unchanged
# file comes back as a cheap 304 and a changed one as a fresh 200. That round
# trip is wasted on files that never change between deploys (fonts, the
# vendored reveal.js/qrcodejs builds), so those get a long-lived cache below
# instead.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
